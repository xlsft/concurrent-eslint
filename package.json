{
  "name": "concurrent-eslint",
  "version": "0.1.1",
  "description": "Multi-process ESLint runner: live progress, a CPU/memory safeguard, warm workers between runs and a shared cache",
  "keywords": [
    "eslint",
    "lint",
    "parallel",
    "concurrent",
    "multi-process",
    "workers",
    "cli"
  ],
  "license": "MIT",
  "author": "itorshin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xlsft/concurrent-eslint.git"
  },
  "bugs": {
    "url": "https://github.com/xlsft/concurrent-eslint/issues"
  },
  "homepage": "https://github.com/xlsft/concurrent-eslint#readme",
  "type": "module",
  "bin": {
    "concurrent-eslint": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "docs": "node scripts/jsdoc.mjs",
    "lint": "node src/cli.ts --headless --no-daemon",
    "check": "npm run typecheck && npm run lint && npm run docs && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0"
  }
}
